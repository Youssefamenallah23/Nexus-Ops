# LLM providers — priority: NVIDIA (Mistral) > Google (Gemini) > deterministic mock
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# Automation — paste your n8n production webhook URL here (empty = mock mode)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=nexus-dev-secret

# Agent config
AGENT_REVIEW_THRESHOLD=0.80

# Frontend -> Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
