# LLM providers — leave GOOGLE_API_KEY empty to run in deterministic mock mode
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# Automation (milestone 4)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Agent config
AGENT_REVIEW_THRESHOLD=0.80

# Frontend -> Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
